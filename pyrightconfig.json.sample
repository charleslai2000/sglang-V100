{
  "include": ["python", "test", "tests"],
  "exclude": [
    "**/.venv",
    "**/venv",
    "**/build",
    "**/build-*",
    "**/__pycache__"
  ],
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "venvPath": "<absolute-path-to-virtual-environment-parent>",
  "venv": "<environment-name>",
  "extraPaths": [
    "python",
    "sgl-kernel/python",
    "experiments/E035-g022-actorder-q4-wmma"
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": "error"
}
